{
  "schemaVersion": 1,
  "id": "mineux",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "A Linux desktop for Minecraft: a tiling window manager, terminals, workstations, and a home and Esc desk.",
  "authors": ["goblinpiss"],
  "contact": {
    "homepage": "https://mineux.com"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mineux.fabric.MineUXMod",
      "com.mineux.screens.fabric.ScreensMod"
    ]
  },
  "mixins": [
    "mineux.mixins.json",
    "mineux.screens.mixins.json"
  ],
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}"
  }
}
